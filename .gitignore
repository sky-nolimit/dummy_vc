# ============================================================
# Dummy 机械臂视觉抓取工作区
# ============================================================

# --- ROS 2 / colcon 构建产物 ---
build/
install/
log/
*.pyc
__pycache__/

# --- 编辑器 / IDE ---
.vscode/
.idea/
*.swp
*~

# --- 阶段 0 实测的原始记录（体积大且机器相关，不入库）---
#     标定节点默认把快照追加到 ~/stage0_snapshots.log，本来就在仓库外；
#     这里再挡一层，防止有人把原始记录拷进来。
#     权威参数表是 dummy_controller/config/dummy_controller.yaml，它要入库。
tools/stage0_raw/

# --- 杂项运行产物 ---
debug.log

# --- Python ---
*.egg-info/
.pytest_cache/
.coverage

# --- 参考资料里的第三方二进制（zadig 是 Windows USB 驱动安装程序，
#     在 Ubuntu 上永远不会用到，node_modules 同理）---
reference/**/zadig-*.exe
reference/**/node_modules/

# --- 参考资料里的第三方库 ---
#
# esp32-iot 是 Mongoose OS 的库（Sergey Lyubka / Cesanta），80 MB、2851 个
# 文件，带十几个各厂商的 demo 工程。它是 Dummy 那块 ESP32 联网板用的，与
# 机械臂本体无关，而且上游有仓库可以取。
#
# 文件仍然在磁盘上（git rm --cached 只改索引），只是不进版本库。
# 需要看它的时候直接读 `reference/Firmware/esp32-iot/`。
reference/Firmware/esp32-iot/

