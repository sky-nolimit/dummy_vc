<?xml version="1.0" ?>
<robot name="dummy2_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find dummy2_urdf_description)/urdf/materials.xacro" />
<xacro:include filename="$(find dummy2_urdf_description)/urdf/dummy2_urdf.trans" />
<xacro:include filename="$(find dummy2_urdf_description)/urdf/dummy2_urdf.gazebo" />

<!-- ==========================================================================
     可调参数
     ==========================================================================
     下面这几个值决定夹持点和相机在模型里的位置。凡是标了「实测」的，
     都要按实测量出来再改（标定手册在本机 docs/02，不上传）。

     数值偏 5 mm，IK 就会把末端整体偏移 5 mm，抓取时表现为
     「对准了但没夹住」——而且你会先怀疑视觉，浪费大量时间在后处理上。
     ========================================================================== -->

<!-- 手指伸出的方向：URDF 里手爪挂在 link7 的 +y 方向 -->
<xacro:property name="hand_axis" value="y"/>

<!-- link7 -> 两指夹持中心(指尖前端中点)，沿 hand_axis 的距离。
     实测：2026-10-16 尺量，约 15 mm。
     注意它比 hand 关节的 0.052312 还小，所以 gripper_tcp 落在 hand 坐标系
     原点的**后方**（y = 0.015 - 0.052312 = -0.037312，即比 hand 原点更靠近
     link7）—— 实物手爪的两指是贴着腕部夹的。URDF 里那套手指几何来自原作者
     模型、与实物不符（docs/04 A1），两者不能互相印证。 -->
<xacro:property name="tcp_offset_y" value="0.015"/>

<!-- 相机的安装参数（外置支架，eye-to-hand）定义在文件末尾的相机段落里，
     因为那里有较长的说明。用 grep 搜 camera_offset 可以找到。 -->

<!-- ==========================================================================
     基座虚拟关节
     ==========================================================================
     MoveIt 需要一个能把机械臂固定到某个世界坐标系的虚拟关节。
     固定式（而非浮动式）意味着机械臂底座在规划中不可移动。
     ========================================================================== -->
<link name="world"/>

<joint name="world_to_base" type="fixed">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="world"/>
  <child link="base_link"/>
</joint>

