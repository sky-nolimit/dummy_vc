<?xml version="1.0" ?>
<robot name="dummy2_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find dummy2_urdf_description)/urdf/materials.xacro" />
<xacro:include filename="$(find dummy2_urdf_description)/urdf/dummy2_urdf.trans" />
<xacro:include filename="$(find dummy2_urdf_description)/urdf/dummy2_urdf.gazebo" />

<!-- ==========================================================================
     可调参数
     ==========================================================================
     下面这几个值决定夹持点和相机在模型里的位置。凡是标了「实测」的，
     都要按实测量出来再改（标定手册在本机 docs/02，不上传）。

     数值偏 5 mm，IK 就会把末端整体偏移 5 mm，抓取时表现为
     「对准了但没夹住」——而且你会先怀疑视觉，浪费大量时间在后处理上。
     ========================================================================== -->

<!-- 手指伸出的方向：URDF 里手爪挂在 link7 的 +y 方向 -->
<xacro:property name="hand_axis" value="y"/>

<!-- 实物夹爪的实测几何（2026-10-21 用尺子在整机上量的）。
     ==========================================================
     腕部(link7 端面) -> 指尖            130 mm
       其中 80 mm 是舵机 + 驱动板 + 导轨那些不动的结构
       剩下 50 mm 是可开合的手指（15 mm 滑动结构 + 35 mm 真正夹取段）
     夹取中心 = 35 mm 夹取段的中点，离指尖 17.5 mm
              => 离腕部 130 - 17.5 = 112.5 mm
     最大开口（两指内侧面之间）         55 mm
     单指板厚：三角截面，最厚 10 mm、最薄约 3 mm，这里按 8 mm 的均值
     指尖宽度：这次没量，先按 25 mm 占位

     之前这里写的是 15 mm —— 那次量的不是夹取中心（从照片和 130 mm 的
     总长看，量到的是夹爪本体的某个面），已作废。这个数是 A1 的修复：
     URDF 原来用的是原作者通用夹爪的网格，指尖落在腕部以下 116 mm，比
     实物长了约 100 mm —— 于是一开碰撞检查，抓取位姿就整只手埋进桌面，
     MoveIt 报 "Unable to sample any valid states for goal tree"。 -->
<xacro:property name="gripper_wrist_to_tip_m" value="0.130"/>
<xacro:property name="gripper_body_y_m" value="0.080"/>
<xacro:property name="gripper_finger_y_m" value="0.050"/>
<xacro:property name="gripper_tip_to_centre_m" value="0.0175"/>
<xacro:property name="gripper_open_gap_m" value="0.055"/>
<xacro:property name="gripper_finger_thick_m" value="0.008"/>
<xacro:property name="gripper_finger_width_m" value="0.025"/>
<xacro:property name="gripper_body_x_m" value="0.090"/>
<xacro:property name="gripper_body_z_m" value="0.050"/>
<!-- 半行程 = 一指从全闭到全开走多远 -->
<xacro:property name="gripper_finger_travel_m" value="${gripper_open_gap_m/2}"/>
<!-- link7 端面 -> 两指夹持中心（gripper_tcp 就放在这里） -->
<xacro:property name="tcp_offset_y" value="${gripper_wrist_to_tip_m - gripper_tip_to_centre_m}"/>

<!-- 相机的安装参数（外置支架，eye-to-hand）定义在文件末尾的相机段落里，
     因为那里有较长的说明。用 grep 搜 camera_offset 可以找到。 -->

<!-- ==========================================================================
     基座虚拟关节
     ==========================================================================
     MoveIt 需要一个能把机械臂固定到某个世界坐标系的虚拟关节。
     固定式（而非浮动式）意味着机械臂底座在规划中不可移动。
     ========================================================================== -->
<link name="world"/>

<joint name="world_to_base" type="fixed">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="world"/>
  <child link="base_link"/>
</joint>

<link name="base_link">
  <inertial>
    <origin xyz="-2.0924404922447642e-07 0.0002265177622702009 0.038857658386839265" rpy="0 0 0"/>
    <mass value="3.5330582052606796"/>
    <inertia ixx="0.006118" iyy="0.006527" izz="0.007083" ixy="-0.0" iyz="-3.1e-05" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy2_urdf_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy2_urdf_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

