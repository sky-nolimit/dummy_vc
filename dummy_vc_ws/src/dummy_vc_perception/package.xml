<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dummy_vc_perception</name>
  <version>0.1.0</version>
  <description>
    视觉感知：把相机图像变成 base_link 下的抓取目标
    （vision_msgs/Detection3DArray）。

    分两层：geometry.py / gripper.py 是纯 numpy 的几何与夹爪模型，没有 ROS
    依赖，所以能在没有 ROS 的机器上离线自测；节点只负责 ROS 接口与 TF。
    相机到位前先用 driver 里现成的 USB 相机，接口按深度相机标准设计。
  </description>
  <!-- 邮箱要有 @ 和带点的域名：dummy-vc@localhost 会让整个 manifest 解析失败，
       colcon 只打一行 WARNING 就继续，结果是包编好了但 ros2 pkg 找不到它。 -->
  <maintainer email="dummy-vc@example.com">Dummy VC</maintainer>
  <license>MIT</license>

  <!-- geometry.py / gripper.py / detection.py 只要 numpy；
       vision_node.py 才需要 ROS 的那几个包。 -->
  <depend>rclpy</depend>
  <depend>python3-numpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_ros_py</depend>

  <!-- launch/vision_demo.launch.py：起 robot_state_publisher（URDF -> TF）、
       可选地起 Orbbec 相机，再起 vision_node。 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>dummy2_urdf_description</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
